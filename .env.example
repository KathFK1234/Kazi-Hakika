# Copy to .env for local development. Never commit .env.
# Every setting is listed with its default; app/config.py is the reference.

APP_NAME="Kazi Hakika"
APP_TAGLINE="verified roles, tracked your way."
ENVIRONMENT=development        # development | test | production
LOG_LEVEL=INFO
BASE_URL=http://localhost:8000 # must be https:// in production

# --- Database ---
# The app connects as kazi_app, a NON-superuser role, so row-level security applies.
DATABASE_URL=postgresql+psycopg://kazi_app:kazi_app@localhost:5432/kazi_hakika
# Migrations run as the database owner; the web start script unsets this before serving.
MIGRATIONS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kazi_hakika
DB_POOL_SIZE=5                 # plus as many overflow connections
DB_STATEMENT_TIMEOUT_MS=5000

# --- Security ---
# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Production refuses to start with the default.
SECRET_KEY=change-me
SESSION_DAYS=14                # sign-in lasts this long (1 to 90)
# Proxies that append to X-Forwarded-For (Railway: 1). Used for per-IP rate limits.
TRUSTED_PROXY_HOPS=0             # production refuses to start unless this is set
MAX_BODY_BYTES=65536           # request body cap (64 KB, a cost guard)

# --- Email (Resend free plan: 3,000 a month, 100 a day) ---
# Leave the key empty to log emails instead of sending them.
RESEND_API_KEY=
# onboarding@resend.dev is Resend's test sender: it ONLY delivers to the Resend
# account owner's own address. Real users need a verified domain (Phase 4).
EMAIL_FROM="Kazi Hakika <onboarding@resend.dev>"
EMAIL_DAILY_LIMIT=90           # hard stop, under Resend's 100 a day
EMAIL_DIGEST_RESERVE=30        # held back for reminders: other emails stop at 60

# Moderators: comma-separated emails (at most 5), applied on web start by the
# database owner. Only these accounts, once confirmed, can moderate the board.
ADMIN_EMAILS=

# Dira career check-ins: off until /support lists real contacts.
DIRA_ENABLED=false
